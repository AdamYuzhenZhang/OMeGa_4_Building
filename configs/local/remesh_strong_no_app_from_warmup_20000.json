{
  "kind": "extension",
  "description": "20000-step OMeGa-4-Building stronger in-training remesh test. This uses the same no-app-opt baseline/warmup, but remeshes more often and more aggressively to test whether repeated planar simplification can remove messy corner/fold geometry.",
  "extends": "baseline_no_app_from_warmup_20000.json",
  "trainer": "examples/simple_trainer_meshgs_training_remesh.py",
  "args": {
    "result_dir": "${PACKAGE_ROOT}/omega/model_remesh_strong_no_app_from_warmup_20000",
    "training_remesh_on": true,
    "training_remesh_start_iter": 7600,
    "training_remesh_every": 2500,
    "training_remesh_stop_iter": 18100,
    "training_remesh_target_faces": 0,
    "training_remesh_target_ratio": 0.35,
    "training_remesh_reparent_k": 32,
    "training_remesh_reparent_chunk_size": 65536,
    "training_remesh_preview_on": true,
    "training_remesh_preview_error_vmax_m": 0.05,
    "training_remesh_preview_error_reference_max_faces": 400000,
    "training_remesh_topology_cleanup": true,
    "training_remesh_planar_quadric": true,
    "training_remesh_planar_weight": 0.0002,
    "training_remesh_quality_weight": true,
    "training_remesh_preserve_boundary": true,
    "training_remesh_boundary_weight": 3.0,
    "training_remesh_preserve_normal": true,
    "training_remesh_preserve_topology": true,
    "training_remesh_crease_angle_deg": 80.0,
    "training_remesh_boundary_quality": 0.8,
    "training_remesh_min_quality": 0.02,
    "training_remesh_quality_gamma": 2.0
  },
  "post_train": {
    "plot_losses": true,
    "plot_losses_smooth_window": 5
  }
}
