{
  "kind": "baseline",
  "description": "Clean OMeGa baseline with local debug previews and all existing OMeGa losses enabled.",
  "trainer": "examples/simple_trainer_meshgs.py",
  "args": {
    "disable_viewer": true,
    "data_dir": "${PACKAGE_ROOT}/omega/dataset",
    "data_factor": 1,
    "result_dir": "${PACKAGE_ROOT}/omega/model_baseline_debug_6500",
    "path_to_mesh": "${PACKAGE_ROOT}/omega/init_mesh.ply",
    "max_steps": 6500,
    "test_every": 8,
    "save_steps": [6500],
    "eval_steps": [1500, 3000, 4500, 6500],
    "vfm_init": true,
    "app_opt": true,
    "mesh_loss": true,
    "mesh_smooth_lambda": 40.0,
    "mesh_normal_consistency_lambda": 1.0,
    "normal_map_on": true,
    "mono_normal_loss": true,
    "mono_normal_loss_start_iter": 3000,
    "mono_normal_lambda": 0.5,
    "dist_loss": true,
    "dist_lambda": 0.01,
    "dist_start_iter": 3000,
    "mesh_refine_start_iter": 3000,
    "refine_stop_iter": 6500,
    "mesh_split_topk": 0.02,
    "split_every": 500,
    "remove_start_iter": 5000,
    "remove_every": 500,
    "mesh_preview_on": true,
    "mesh_preview_every": 500,
    "mesh_preview_frame": 0,
    "mesh_preview_max_width": 900,
    "mesh_preview_max_faces": 0,
    "mesh_preview_rotate_clockwise": true,
    "mesh_preview_wire_thickness": 1,
    "mesh_preview_wire_alpha": 0.3
  }
}

